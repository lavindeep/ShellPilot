#!/usr/bin/expect -f
# Reactive demo recording for ShellPilot v0.5.0.
# Driven by expect patterns — responds the instant each prompt appears.
# Record with:
#   cd /tmp/sp-demo
#   asciinema rec --idle-time-limit 2 --cols 100 --rows 30 \
#     -c "expect /path/to/demo.exp" demo.cast

set timeout 300

# Human-feel typing: avg 80 ms per char, min 50 ms, occasional 200 ms pause
set send_human {.08 .15 0.8 .05 1.5}

# Proc: handle all approvals until turn-stats "ctx N%" appears.
# Approves any "Approve?" (write_file, run_command, etc.) and
# any "Approve plan?" that the model may produce.
proc drain_approvals {} {
    set done 0
    while {!$done} {
        expect {
            "Approve plan?" {
                sleep 0.5
                send "y\r"
            }
            "Approve?" {
                sleep 0.3
                send "y\r"
            }
            "ctx " {
                # turn_stats line: "N.Ns · NNN tokens · ctx N%"
                set done 1
            }
            timeout {
                set done 1
            }
        }
    }
}

# ── 1. Boot ──────────────────────────────────────────────────────────────────
cd /tmp/sp-demo
spawn /Users/lavin/Projects/ShellPilot/.venv/bin/shellpilot

# Wait for model picker
expect "Select a model"
sleep 0.5
# Accept default (gemma4:e4b)
send "\r"

# Wait for banner (ShellPilot 0.5.0)
expect "ShellPilot 0.5.0"

# Let prompt_toolkit settle after banner
sleep 2

# ── 2. Turn 1: multi-step greeting project ───────────────────────────────────
send -h "create a tiny python project: greeting.py with a greet() function that returns \"Hello!\" and a README, then run greet() to show it works"
send "\r"

# Drain approvals (handles plan approval + write_file + run_command)
# until turn stats appear
drain_approvals

sleep 1.5

# ── 3. Turn 2: image colour question ─────────────────────────────────────────
send -h "what color is red.png? use view_image"
send "\r"

# view_image is LOW risk / auto-run, so no approval needed normally.
# Drain any unexpected approvals and wait for turn stats.
drain_approvals

sleep 1.5

# ── 4. Exit ──────────────────────────────────────────────────────────────────
send "/exit\r"
expect eof
